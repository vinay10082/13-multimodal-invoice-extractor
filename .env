# --- Model configuration ---
# HuggingFace checkpoint used for field-level extraction.
# Default is a LayoutLM checkpoint fine-tuned for invoice document-question-answering.
MODEL_CHECKPOINT_PATH=impira/layoutlm-invoices

# Device for model inference: "cpu", "cuda", or "cuda:0"
DEVICE=cpu

# --- OCR configuration ---
# Minimum confidence (0-1) required from the LayoutLM field extractor before the
# regex heuristic fallback engine is triggered for a given field.
OCR_MIN_CONFIDENCE=0.5

# Enable/disable the deterministic regex fallback engine entirely.
ENABLE_REGEX_FALLBACK=true

# --- Output configuration ---
# Directory where extracted JSON results are written when --output is not given.
OUTPUT_DIR=output

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
